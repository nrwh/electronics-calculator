exports[`buck schematic > {"topology":"async"} 1`] = `"<svg class="schematic" viewBox="4 3 378 133" role="img" aria-labelledby="sch-title sch-desc" preserveAspectRatio="xMidYMid meet"><title id="sch-title">Buck converter schematic</title><desc id="sch-desc">V_in switches through Q1 to the switch node; Schottky diode D1 returns the inductor current when Q1 is off. L (10 µH) and C_out (8.2 µF) filter the output; R_top and R_bot feed back to the controller.</desc><path class="sw" d="M145 40 L140 40"/><path class="sw" d="M175 40 L180 40"/><path class="sw" d="M130 75 L130 80"/><path class="sw" d="M130 45 L130 40"/><path class="sw" d="M210 45 L210 40"/><path class="sw" d="M210 75 L210 80"/><path class="sw" d="M270 45 L270 40"/><path class="sw" d="M270 75 L270 80"/><path class="sw" d="M320 45 L320 40"/><path class="sw" d="M320 75 L320 80"/><path class="sw" d="M320 85 L320 80"/><path class="sw" d="M320 115 L320 120"/><path class="sw" d="M20 40 L80 40"/><path class="sw" d="M120 40 L130 40"/><path class="sw" d="M130 40 L140 40"/><path class="sw" d="M130 80 L130 120"/><path class="sw" d="M180 40 L210 40"/><path class="sw" d="M210 40 L270 40"/><path class="sw" d="M270 40 L320 40"/><path class="sw" d="M320 40 L350 40"/><path class="sw" d="M320 80 L350 80"/><path class="sw" d="M20 80 L20 120"/><path class="sw" d="M20 120 L130 120"/><path class="sw" d="M130 120 L170 120"/><path class="sw" d="M170 120 L210 120"/><path class="sw" d="M210 120 L270 120"/><path class="sw" d="M270 120 L320 120"/><path class="sw" d="M210 80 L210 120"/><path class="sw" d="M270 80 L270 120"/><circle class="sb sbg" cx="20" cy="60" r="10"/><path class="sb" d="M15 59 L25 59"/><path class="sb" d="M17 61 L15 61"/><path class="sb" d="M21 61 L19 61"/><path class="sb" d="M25 61 L23 61"/><path class="sb" d="M20 40 L20 50"/><path class="sb" d="M20 80 L20 70"/><circle class="sb" cx="92" cy="40" r="2"/><path class="sb" d="M94 39 L106 33"/><circle class="sb" cx="108" cy="40" r="2"/><path class="sb" d="M80 40 L90 40"/><