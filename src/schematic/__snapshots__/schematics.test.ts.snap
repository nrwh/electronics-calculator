exports[`_template schematic > {} 1`] = `"<svg class="schematic" viewBox="14 14 185 113" role="img" aria-labelledby="sch-title sch-desc" preserveAspectRatio="xMidYMid meet"><title id="sch-title">Voltage divider schematic</title><desc id="sch-desc">R1 10 kΩ from the input to the output, R2 3.9 kΩ from the output to ground.</desc><path class="sw" d="M120 25 L120 20"/><path class="sw" d="M120 55 L120 60"/><path class="sw" d="M120 75 L120 70"/><path class="sw" d="M120 105 L120 110"/><path class="sw" d="M30 20 L120 20"/><path class="sw" d="M120 60 L120 70"/><path class="sw" d="M120 60 L180 60"/><path class="sw" d="M30 60 L30 110"/><path class="sw" d="M30 110 L80 110"/><path class="sw" d="M80 110 L120 110"/><circle class="sb sbg" cx="30" cy="40" r="10"/><path class="sb" d="M25 39 L35 39"/><path class="sb" d="M27 41 L25 41"/><path class="sb" d="M31 41 L29 41"/><path class="sb" d="M35 41 L33 41"/><path class="sb" d="M30 20 L30 30"/><path class="sb" d="M30 60 L30 50"/><path class="sb" d="M116 50 L124 50 L124 30 L116 30 Z"/><path class="sb" d="M120 25 L120 30"/><path class="sb" d="M120 55 L120 50"/><path class="sb" d="M116 100 L124 100 L124 80 L116 80 Z"/><path class="sb" d="M120 75 L120 80"/><path class="sb" d="M120 105 L120 100"/><circle class="sb sbg" cx="180" cy="60" r="3"/><path class="sb" d="M80 110 L80 115 L85 115 L80 120 L75 115 L80 115"/><circle class="sf" cx="120" cy="60" r="2.6"/><text class="st" x="30" y="32.5" dy="0.35em" text-anchor="middle">+</text><text class="sch-ref" x="44" y="33.65" dy="0.35em" text-anchor="start">V1</text><text class="sch-val" x="44" y="46.3" dy="0.35em" text-anchor="start">12 V</text><text class="sch-ref" x="129" y="33.65" dy="0.35em" text-anchor="start">R1</text><text class="sch-val" x="129" y="46.3" dy="0.35em" text-anchor="start">10 kΩ</text><text class="sch-ref" x="129" y="83.65" dy="0.35em" text-anchor="start">R2</text><text class="sch-val" x="129" y="96.3" dy="0.35em" text-anchor="start">3.9 kΩ</text><text class="sch-lbl" x="180" y=