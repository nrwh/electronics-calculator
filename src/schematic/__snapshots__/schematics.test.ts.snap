exports[`differentiator schematic > {} 1`] = `"<svg class="schematic" viewBox="4 -1 285 166" role="img" aria-labelledby="sch-title sch-desc" preserveAspectRatio="xMidYMid meet"><title id="sch-title">Differentiator schematic</title><desc id="sch-desc">The input passes through C (10 nF) and R1 (820 Ω) to the inverting input. Rf (16 kΩ) and Cf (470 pF) are in parallel from the inverting input to the output. The non-inverting input is grounded.</desc><path class="sw" d="M45 100 L40 100"/><path class="sw" d="M75 100 L80 100"/><path class="sw" d="M85 100 L80 100"/><path class="sw" d="M115 100 L120 100"/><path class="sw" d="M175 30 L170 30"/><path class="sw" d="M205 30 L210 30"/><path class="sw" d="M175 60 L170 60"/><path class="sw" d="M205 60 L210 60"/><path class="sw" d="M20 100 L40 100"/><path class="sw" d="M120 100 L140 100"/><path class="sw" d="M140 100 L160 100"/><path class="sw" d="M140 100 L140 60"/><path class="sw" d="M140 60 L140 30"/><path class="sw" d="M140 30 L170 30"/><path class="sw" d="M140 60 L170 60"/><path class="sw" d="M210 30 L240 30"/><path class="sw" d="M240 30 L240 60"/><path class="sw" d="M240 60 L240 110"/><path class="sw" d="M210 60 L240 60"/><path class="sw" d="M220 110 L240 110"/><path class="sw" d="M240 110 L270 110"/><path class="sw" d="M160 120 L160 140"/><circle class="sb sbg" cx="20" cy="120" r="10"/><path class="sb" d="M15 120 A2.5 2.5 0 0 1 20 120"/><path class="sb" d="M25 120 A2.5 2.5 0 0 1 20 120"/><path class="sb" d="M20 100 L20 110"/><path class="sb" d="M20 140 L20 130"/><path class="sb" d="M57 108 L57 92"/><path class="sb" d="M63 108 L63 92"/><path class="sb" d="M45 100 L56 100"/><path class="sb" d="M75 100 L64 100"/><path class="sb" d="M110 104 L90 104 L90 96 L110 96 Z"/><path class="sb" d="M85 100 L90 100"/><path class="sb" d="M115 100 L110 100"/><path class="sb sbg" d="M170 85 L210 110 L170 135 L170 85 Z"/><path class="sb" d="M160 100 L170 100"/><path class="sb" d="M160 120 L170 120"/><path class="sb" d="M220 110 L210 110"/><path class="sb" d="M187 38 L187 22"/><path class="sb" d="M193 38 L193 22"/><path class="sb" d="M175 30 L186 30"/><path class="sb" d="M205 30 L194 30"/><path class="sb" d="M200 64 L180 64 L180 56 L200 56 Z"/><path class="sb" d="M175 60 L180 60"/><path class="sb" d="M205 60 L200 60"/><circle class="sb sbg" cx="270" cy="110" r="3"/><path class="sb" d="M160 140 L160 145 L165 145 L160 150 L155 145 L160 145"/><path class="sb" d="M20 140 L20 145 L25 145 L20 150 L15 145 L20 145"/><circle class="sf" cx="140" cy="100" r="2.6"/><circle class="sf" cx="140" cy="60" r="2.6"/><circle class="sf" cx="240" cy="60" r="2.6"/><circle class="sf" cx="240" cy="110" r="2.6"/><text class="st" x="20" y="112.5" dy="0.35em" text-anchor="middle">+</text><text class="sch-ref" x="34" y="113.65" dy="0.35em" text-anchor="start">V1</text><text class="sch-lbl" x="34" y="126.3" dy="0.35em" text-anchor="start">V<tspan dy="3" font-size="75%">in</tspan><tspan dy="-3">​</tspan></text><text class="sch-ref" x="60" y="69.15" dy="0.35em" text-anchor="middle">C1</text><text class="sch-val" x="60" y="81.8" dy="0.35em" text-anchor="middle">10 nF</text><text class="sch-ref" x="100" y="74.15" dy="0.35em" text-anchor="middle">R1</text><text class="sch-val" x="100" y="86.8" dy="0.35em" text-anchor="middle">820 Ω</text><text class="st" x="173" y="100" dy="0.35em" text-anchor="start">−</text><text class="st" x="173" y="120" dy="0.35em" text-anchor="start">+</text><text class="sch-ref" x="184" y="140.15" dy="0.35em" text-anchor="start">U1</text><text class="sch-val" x="184" y="152.8" dy="0.35em" text-anchor="start">GBW 3 MHz</text><text class="sch-ref" x="187" y="12.15" dy="0.35em" text-anchor="end">C<tspan dy="3" font-size="75%">f</tspan><tspan dy="-3">​</tspan></text><text class="sch-val" x="193" y="11.8" dy="0.35em" text-anchor="start">470 pF</text><text class="sch-ref" x="187" y="47.15" dy="0.35em" text-anchor="end">R<tspan dy="3" font-size="75%">f</tspan><tspan dy="-3">​</tspan></text><text class="sch-val" x="193" y="4